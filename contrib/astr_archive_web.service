[Unit]
Description=Chat Archive Standalone WebUI
After=network.target

[Service]
Type=simple
# 请将 WorkingDirectory 更改为您的实际 AstrBot plugins 目录路径
WorkingDirectory=/path/to/AstrBot/data/plugins
# 可选：如果未在插件主配置中指定 api_key，可以通过环境变量直接指定
# Environment=ARCHIVE_API_KEY=your_secure_password
# 可选：覆盖数据库、监听地址、端口或 SQLite 日志模式
# Environment=ARCHIVE_DB_PATH=/path/to/chat_history.db
# Environment=ARCHIVE_HOST=127.0.0.1
# Environment=ARCHIVE_PORT=8090
# Environment=ARCHIVE_SQLITE_JOURNAL_MODE=WAL
# Environment=ARCHIVE_AUTH_FAILURE_LIMIT=8
# Environment=ARCHIVE_AUTH_LOCKOUT_SECONDS=300
# 限制新建数据库、缓存和失败写入日志的默认文件权限
UMask=0077
# 基础进程加固；如需访问额外系统路径，请按实际部署调整 systemd 权限项
NoNewPrivileges=true
# 请将路径指向您的 AstrBot 虚拟环境 Python，或者使用系统的 python3
ExecStart=/path/to/AstrBot/.venv/bin/python3 -m astrbot_plugin_chat_archive.web.server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
